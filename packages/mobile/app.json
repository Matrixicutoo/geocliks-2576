{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.geocliks.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0E13"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCooTC1R7KhuG9RoI3dsqqpujHtrpfWGTc"
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "5a0e9262-b5c1-4da3-ab37-2012eff9013f"
      },
      "apiUrl": "https://geocliks.com/",
      "applicationId": "timemar-nt1ia4s",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.geocliks.app",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyCooTC1R7KhuG9RoI3dsqqpujHtrpfWGTc"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B0E13"
    },
    "name": "GeoCliks",
    "slug": "geocliks",
    "owner": "matrixicutoo",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5a0e9262-b5c1-4da3-ab37-2012eff9013f"
    },
    "scheme": "runable-timemar-nt1ia4s",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFB021"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GeoCliks uses the camera to take the job-site photos and videos you capture as evidence.",
          "microphonePermission": "GeoCliks uses the microphone to record sound with your job-site videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GeoCliks records where each photo was taken so the place and time can be stamped on it and verified later. Location is only read while you are using the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GeoCliks needs your photo library so you can attach pictures you already took to a project."
        }
      ],
      "expo-iap",
      "react-native-document-scanner-plugin"
    ]
  }
}